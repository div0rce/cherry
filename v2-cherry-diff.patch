+const forbiddenAuthorityPayloadPatterns = [
+  /\briskScore\b/,
+  /\$json\.riskScore\b/,
+  /\$json\.forbidden\b/,
+  /\$json\.drift\b/,
+  /String\(\$json\.riskScore/,
