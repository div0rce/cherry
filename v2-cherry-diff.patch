+  );
+  assert.ok(wrongVersionReplay);
+  assert.equal(wrongVersionReplay.matches, false);
+  assert.equal(wrongVersionReplay.reason, 'classifier_version_mismatch');
+
+  const unsupportedEvent = await createAutomationEventRecord({
