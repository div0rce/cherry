+  );
+  assert.ok(mismatchReplay);
+  assert.equal(mismatchReplay.matches, false);
+  assert.equal(mismatchReplay.reason, 'output_hash_mismatch');
+
+  const wrongVersionReplay = await replayAutomationEvent(
