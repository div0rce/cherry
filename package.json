{
  "name": "cherry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run typecheck:scripts",
    "ingest:mcc": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/ingest-mcc.ts",
    "seed:demo": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/seed-demo.ts",
    "audit:integrity": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register scripts/audit-integrity.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "next": "16.0.3",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.10",
    "passkit-generator": "^3.5.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
