{
  "name": "cherry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "node scripts/check-db-ready.mjs",
    "dev": "next dev",
    "build": "npm run check:server-entropy && npm run check:authority-invariants && next build",
    "start": "next start",
    "check:clean": "node ./scripts/assert-clean-tree.mjs",
    "check:routes": "node ./scripts/check-routes-structure.mjs",
    "check:engine-freeze": "node ./scripts/check-engine-freeze.mjs",
    "lint": "npm run lint:tailwind && npm run lint:eslint && npm run ts:esm -- -r tsconfig-paths/register scripts/check-authority-lint.mts",
    "lint:eslint": "eslint .",
    "lint:scripts": "eslint scripts --max-warnings=0",
    "lint:tailwind": "node ./scripts/check-tailwind-conflicts.mjs",
    "ts:esm": "CHERRY_TSESM=1 npx tsx --tsconfig tsconfig.scripts.json",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "check:server-entropy": "npm run ts:esm -- scripts/check-no-server-entropy.mts",
    "check:ordering": "npm run ts:esm -- scripts/check-no-implicit-ordering.mts",
    "check:identity": "npm run ts:esm -- scripts/check-no-implicit-identity.mts",
    "check:config": "npm run ts:esm -- scripts/check-no-implicit-config.mts",
    "check:side-effects": "npm run ts:esm -- scripts/check-no-side-effects.mts",
    "check:side-effects:diff": "npm run ts:esm -- scripts/check-side-effects-diff.mts",
    "check:config-init": "npm run ts:esm -- scripts/check-config-init-boundaries.mts",
    "check:determinism": "npm run ts:esm -- scripts/check-no-implicit-time.mts",
    "check:script-semantics": "npm run ts:esm -- scripts/check-script-module-semantics.mts",
    "check:engine-prisma": "npm run ts:esm -- scripts/check-no-engine-prisma.mts",
    "check:engine-date": "npm run ts:esm -- scripts/check-no-engine-date.mts",
    "check:catch-unknown": "if rg \"catch\\s*\\(\" app lib | rg -v \"unknown\"; then echo \"Raw catch without unknown\"; exit 1; fi",
    "check:repo-guardrails": "node scripts/check-repo-guardrails.js",
    "check:user-pages-runtime": "npm run ts:esm -- scripts/check-user-pages-runtime-only.mts",
    "check:config-lock": "npm run ts:esm -- -r tsconfig-paths/register scripts/check-config-locking.mts",
    "check": "npm run check:side-effects && npm run check:side-effects:diff && npm run check:server-entropy && npm run check:ordering && npm run check:identity && npm run check:config && npm run check:config-init && npm run check:config-lock && npm run check:determinism && npm run check:script-semantics && npm run check:engine-prisma && npm run check:engine-date && npm run lint && npm run lint:scripts && npm run typecheck && npm run typecheck:scripts",
    "check:guardrails": "npm run check:side-effects && npm run check:side-effects:diff && npm run check:script-semantics && npm run check:engine-prisma && npm run check:engine-date && npm run check:catch-unknown && npm run ts:esm -- scripts/check-guardrails.mts",
    "check:dev-ui-parity": "npm run ts:esm -- scripts/check-dev-ui-parity.mts",
    "check:shell-boundaries": "npm run ts:esm -- scripts/check-shell-boundaries.mts",
    "check:route-collisions": "npm run ts:esm -- scripts/check-route-collisions.mts",
    "ingest:mcc": "npm run ts:esm -- -r tsconfig-paths/register scripts/ingest-mcc.mts",
    "dev:ingest:moustafa-bank": "npm run ts:esm -- -r tsconfig-paths/register scripts/ingest-moustafa-bank-csv.mts",
    "dev:evaluator:moustafa": "npm run ts:esm -- -r tsconfig-paths/register scripts/run-offline-evaluator-moustafa.mts",
    "seed:demo": "npm run ts:esm -- -r tsconfig-paths/register scripts/seed-demo.mts",
    "audit:integrity": "npm run ts:esm -- -r tsconfig-paths/register scripts/audit-integrity.mts",
    "backfill:category-preference-enum": "npm run ts:esm -- -r tsconfig-paths/register scripts/backfill_category_preference_enum.mts",
    "cleanup:vine-sessions": "npm run ts:esm -- -r tsconfig-paths/register scripts/cleanup_expired_vine_sessions.mts",
    "check:prisma-assumptions": "npm run ts:esm -- scripts/check-prisma-assumptions.mts",
    "check:db": "node scripts/check-db-smoke.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "report:authority": "npm run ts:esm -- -r tsconfig-paths/register scripts/authority-coverage.mts",
    "check:authority-invariants": "npm run ts:esm -- -r tsconfig-paths/register scripts/check-authority-invariants.mts",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "test": "npm run check:side-effects && npm run check:side-effects:diff && npm run check:server-entropy && npm run check:ordering && npm run check:identity && npm run check:config && npm run check:config-init && npm run check:config-lock && npm run check:prisma-assumptions && npm run check:dev-ui-parity && npm run check:shell-boundaries && npm run check:route-collisions && node ./scripts/run-tests.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "csv-parse": "^6.1.0",
    "next": "^16.0.8",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.10",
    "passkit-generator": "^3.5.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/language-server": "^0.14.29",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-zod": "^1.4.0",
    "fast-glob": "^3.3.3",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
