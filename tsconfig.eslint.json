{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "next.config.ts",
    "middleware.ts",
    "next-env.d.ts",
    "types/compat/**/*.d.ts",
    "types/compat/**/*.d.cts",
    "types/jsx-global.d.ts",
    "tailwind.config.ts",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "coverage",
    "tests/fixtures"
  ]
}
