+function normalizeChangedFiles(jsCode: string, items: Array<{ json: unknown }>): unknown[] {
+  const output = vm.runInNewContext(`(() => {\n${jsCode}\n})()`, {
+    $input: { all: () => items },
+    $items: (name: string) =>
+      name === 'Normalize PR' ? [{ json: { repo: 'div0rce/cherry' } }] : [],
