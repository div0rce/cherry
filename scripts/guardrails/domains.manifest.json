  "allowedViolations": [
    {
      "from": "lib/engine/legacy.ts",
      "to": "lib/legacy-engine.ts",
      "reason": "Legacy engine facade re-exports the Prisma-backed runtime bridge; importing lib/engine.ts loads Prisma. Engine-freeze change; track as debt."
    },
    {
      "from": "lib/engine/public.ts",
      "to": "lib/engine-state.ts",
      "reason": "Autopilot swipe entrypoint reaches Prisma engine-state loader through the engine barrel. Engine-freeze change; track as debt."
    },
    {
      "from": "lib/engine/public.ts",
      "to": "lib/scan-helpers.ts",
      "reason": "Value cycle engine -> scan-helpers -> engine. Engine-freeze change; track as debt."
    },
    {
      "from": "lib/authority/replayAuthority.ts",
      "to": "lib/adapters/runtime/authority.replay.prisma.ts",
      "reason": "Pure module re-exports a runtime implementation. No importers; candidate for deletion."
    },
    {
      "from": "lib/adapters/runtime/authority.prisma.ts",
      "to": "lib/buckets/periods.ts",
      "reason": "Runtime loader applies pure bucket math (type-only Prisma imports). Exact edge only; runtime may not import other service code. Move bucket math to a core domain to retire."
    },
    {
      "from": "lib/adapters/runtime/authority.prisma.ts",
      "to": "lib/buckets-runtime.ts",
      "reason": "Runtime loader applies pure bucket math (type-only Prisma imports). Exact edge only; runtime may not import other service code. Move bucket math to a core domain to retire."
    },
    {
      "from": "lib/adapters/runtime/engine-state.prisma.ts",
      "to": "lib/buckets/periods.ts",
      "reason": "Runtime loader applies pure bucket math (type-only Prisma imports). Exact edge only; runtime may not import other service code. Move bucket math to a core domain to retire."
    },
    {
      "from": "lib/adapters/runtime/engine-state.prisma.ts",
      "to": "lib/buckets-runtime.ts",
      "reason": "Runtime loader applies pure bucket math (type-only Prisma imports). Exact edge only; runtime may not import other service code. Move bucket math to a core domain to retire."
    },
    {
      "from": "lib/adapters/runtime/legacy-engine.prisma.ts",
      "to": "lib/buckets/periods.ts",
      "reason": "Runtime loader applies pure bucket math (type-only Prisma imports). Exact edge only; runtime may not import other service code. Move bucket math to a core domain to retire."
    }
  ]
