{
  "version": 1,
  "description": "Domain ownership and allowed dependency direction for lib/, app/, components/. Checked by check:domain-boundaries. Type-only imports are not checked. Every source file under the scanned roots must be owned by exactly one domain.",
  "domains": {
    "shared": {
      "layer": "core",
      "description": "Pure helpers with no domain knowledge (errors, enums, text, numbers, money, ids, invariants, routes).",
      "owns": [
        "lib/errors.ts",
        "lib/enums.ts",
        "lib/text.ts",
        "lib/numbers.ts",
        "lib/money.ts",
        "lib/ids.ts",
        "lib/invariants.ts",
        "lib/routes.ts",
        "lib/formatCurrency.ts",
        "lib/server-determinism-fixture.ts",
        "lib/util/**",
        "lib/api/**",
        "types/**",
        "lib/mcc.ts"
      ],
      "mayImport": [],
      "tests": [
        "tests/node/idempotency*.test.ts",
        "tests/node/identity-determinism.test.ts"
      ],
      "docs": []
    },
    "schemas": {
      "layer": "core",
      "description": "Zod request/response contracts and the parseJsonBody boundary helper.",
      "owns": [
        "lib/schemas/**",
        "lib/validation.ts"
      ],
      "mayImport": [
        "shared"
      ],
      "tests": [
        "tests/node/simulate-response-schema.test.js",
        "tests/node/recommendation-temporal-schema.test.ts"
      ],
      "docs": [
        "docs/zod-style.md",
        "docs/api.md"
      ]
    },
    "adapters-contracts": {
      "layer": "core",
      "description": "Pure TypeScript port interfaces (Clock, Logger, Digest, Entropy, stores, World). No implementations.",
