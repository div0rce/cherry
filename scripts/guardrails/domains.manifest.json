        "lib/adapters/*.ts",
        "lib/adapters/contracts/**"
      ],
      "mayImport": [
        "shared"
      ],
      "tests": [
        "tests/node/adapters-contracts.test.ts"
      ],
      "docs": [
        "docs/adapters.md"
      ]
    },
