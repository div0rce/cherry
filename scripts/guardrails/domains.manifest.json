        "docs/engine-time-semantics.md",
        "docs/engine-optimality/status.md",
        "docs/simulation/objective-semantics.md"
      ],
      "invariants": [
        "No Date/Date.now (check:engine-date)",
        "No Prisma (check:engine-prisma)",
        "EngineInput is the only input contract (check:engine-input-boundary)",
        "Behavior/input/candidate/accounting version bumps + chore(engine-freeze) commit (check:engine-version-gates, check:engine-version-bump, check:engine-freeze)"
      ]
