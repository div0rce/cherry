{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "scripts/**/*",
    "prisma/scripts/**/*",
    "tests/node/**/*",
    "tests/guardrails/**/*",
    "lib/engine/optimality/**/*"
  ]
}
